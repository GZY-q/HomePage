# GlassBlog systemd 服务单元
# 安装步骤：
#   1. 代码放到 /opt/glassblog（或修改下方 WorkingDirectory/ExecStart 路径）
#   2. sudo cp deploy/glassblog.service /etc/systemd/system/
#   3. 修改 Environment 中的 ADMIN_PASS 与 SITE_URL（务必！）
#   4. sudo systemctl daemon-reload
#      sudo systemctl enable --now glassblog
#   5. 查看日志：journalctl -u glassblog -f

[Unit]
Description=GlassBlog - 液态玻璃风格个人主页+博客+软件发布站
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/glassblog
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

# 运行账号（建议非 root；确保该账号对项目目录有读写权限）
User=www-data
Group=www-data

# 环境变量：端口 / 管理后台账号密码 / 站点对外 URL（用于 RSS 链接）
Environment=NODE_ENV=production
Environment=PORT=8899
Environment=ADMIN_USER=admin
Environment=ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD
Environment=SITE_URL=https://blog.example.com
# 令牌有效期（天），默认 30
Environment=TOKEN_TTL_DAYS=30

# 基础安全加固
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
